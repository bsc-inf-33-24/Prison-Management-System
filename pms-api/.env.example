# Copy to .env for local development and replace all values.
DB_PASSWORD=change-this-database-password
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret-at-least-32-bytes
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-admin-password
# Comma-separated exact origins for browser/WebView clients; no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
MINIO_ROOT_USER=pms-minio-dev
MINIO_ROOT_PASSWORD=change-this-minio-password
